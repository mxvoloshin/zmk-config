#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt { tapping-term-ms = <120>; };

&lt { tapping-term-ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        a_semi_to_escape {
            timeout-ms = <50>;  // Adjust if needed
            key-positions = <10 19>;  // A (10) + SEMI (19)
            bindings = <&kp ESC>;
        };
        q_p_capslock {
            timeout-ms = <50>;  // Adjust timing if needed
            key-positions = <0 9>;  // Replace with the correct positions for Q and P
            bindings = <&kp CAPS>;
        };
    
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q  &kp W  &kp E        &kp R               &kp T                       &kp Y      &kp U                    &kp I        &kp O    &kp P
&lt 1 A  &kp S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G                       &kp H      &hm RIGHT_SHIFT J        &hm RCTRL K  &kp L    &lt 1 SEMI
&kp Z  &kp X  &kp C        &kp V               &kp B                       &kp N      &kp M                    &kp COMMA    &kp DOT  &kp SQT
                           &mo 2               &kp BACKSPACE               &kp SPACE  &kp ENTER
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp HASH      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp QUESTION     &kp EXCLAMATION  &kp N7  &kp N8  &kp N9  &kp EQUAL
&trans     &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS        &kp UNDERSCORE   &kp N4  &kp N5  &kp N6  &kp BSLH
&kp CARET  &kp AT_SIGN   &kp LBKT              &kp RBKT               &kp DOLLAR       &kp N0           &kp N1  &kp N2  &kp N3  &kp FSLH
                                               &to 3                  &kp LSHIFT       &trans           &trans
            >;
        };

        layer_2 {
            bindings = <
&trans        &trans        &kp LA(TAB)  &kp LC(TAB)     &kp LC(F4)    &kp PAGE_UP    &kp HOME        &kp TAB       &kp END          &none
&sk LEFT_WIN  &sk LEFT_ALT  &sk RCTRL    &sk LEFT_SHIFT  &trans        &kp LEFT       &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans        &trans        &trans       &trans          &trans        &kp PAGE_DOWN  &trans          &trans        &trans           &kp DELETE
                                         &trans          &trans        &trans         &to 3
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans    &trans     &trans     &trans    &kp F12  &kp F7  &kp F8  &kp F9  &trans
&trans  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp F11  &kp F4  &kp F5  &kp F6  &trans
&trans  &trans    &trans     &trans     &trans    &kp F10  &kp F1  &kp F2  &kp F3  &trans
                             &to 0      &trans    &trans   &trans
            >;
        };
    };
};
