#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt { tapping-term-ms = <120>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        a_semi_to_escape {
            timeout-ms = <50>;  // Adjust if needed
            key-positions = <10 19>;  // A (10) + SEMI (19)
            bindings = <&kp ESC>;
        };
        q_p_capslock {
            timeout-ms = <50>;  // Adjust timing if needed
            key-positions = <0 9>;  // Replace with the correct positions for Q and P
            bindings = <&kp CAPS>;
        };
        i_o_backspace {
            timeout-ms = <50>;  // Adjust timing if needed
            key-positions = <7 8>;  // Replace with the correct positions for I and O
            bindings = <&kp BACKSPACE>;
        };
        k_l_enter {
            timeout-ms = <50>;  // Adjust timing if needed
            key-positions = <17 18>;  // Replace with the correct positions for K and L
            bindings = <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q  &kp W       &kp E        &kp R            &kp T                       &kp Y      &kp U                    &kp I        &kp O      &kp P
&kp A  &hm LALT S  &hm LCTRL D  &hm LEFT_SHIFT F &kp G                       &kp H      &hm RIGHT_SHIFT J        &hm RCTRL K  &hm RALT L &kp SEMI
&kp Z  &kp X       &kp C        &kp V            &kp B                       &kp N      &kp M                    &kp COMMA    &kp DOT    &kp SQT
                                &mo 2            &kp LEFT_SHIFT              &kp SPACE  &mo 1
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE        &kp LEFT_PARENTHESIS  &kp LEFT_BRACE &kp LBKT              &kp LT             &kp GT    &kp RBKT              &kp RIGHT_BRACE &kp RIGHT_PARENTHESIS &kp TILDE 
&kp EXCLAMATION  &hm LALT AT_SIGN      &hm LCTRL HASH &hm LEFT_SHIFT DOLLAR &kp PERCENT        &kp CARET &hm RIGHT_SHIFT AMPS  &hm RCTRL ASTRK &hm RALT EQUAL        &kp PLUS
&kp QMARK        &kp PIPE              &kp MINUS      &kp UNDER             &none              &none     &none                 &none           &none                 &none
                                                      &mo 3                 &none              &none     &none
            >;
        };

        layer_2 {
            bindings = <
&kpESC       &none        &kp LA(TAB) &kp LC(TAB)     &kp LC(F4)        &kp PAGE_UP    &kp HOME        &kp TAB       &kp END          &kp BACKSPACE
&sk LEFT_WIN &sk LEFT_ALT &sk RCTRL   &sk LEFT_SHIFT  &none             &kp LEFT       &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ENTER
&none        &none        &none       &none           &none             &kp PAGE_DOWN  &none           &none         &none            &kp DELETE
                                      &none           &none             &none          &mo 3
            >;
        };

        layer_3 {
            bindings = <
&kp F1  &kp F2      &kp F3       &kp F4       &kp F5        &kp F6  &kp F7        &kp F8        &kp F9       &kp F10
&kp N1  &hm LALT N2 &hm LCTRL N3 &hm LSHFT N4 &kp N5        &kp N6  &hm RSHFT N7  &hm RCTRL N8  &hm RALT N9  &kp N0
&kp F11 &none       &none        &none        &none         &none   &none         &none         &none        &kp F12
                                 &none        &none         &none   &none
            >;
        };
    };
};
