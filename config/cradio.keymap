#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T                       &kp Y      &kp U        &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G                       &kp H      &kp J        &kp K      &kp L    &kp SEMI
&kp Z  &kp X  &kp C  &kp V  &kp B                       &kp N      &kp M        &kp COMMA  &kp DOT  &kp SQT
                     &mo 2  &mt LEFT_SHIFT BACKSPACE    &kp SPACE  &lt 1 ENTER
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp HASH      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp QUESTION     &kp EXCLAMATION  &kp N7  &kp N8  &kp N9  &kp EQUAL
&trans     &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS        &kp UNDERSCORE   &kp N4  &kp N5  &kp N6  &kp BSLH
&kp CARET  &kp AT_SIGN   &kp LBKT              &kp RBKT               &kp DOLLAR       &kp N0           &kp N1  &kp N2  &kp N3  &kp FSLH
                                               &to 3                  &mt LSHFT ESC    &trans           &trans
            >;
        };

        layer_2 {
            bindings = <
&trans        &trans        &kp LA(TAB)  &kp LS(TAB)     &kp LC(F4)    &kp PAGE_UP    &kp HOME        &kp TAB       &kp END          &none
&sk LEFT_WIN  &sk LEFT_ALT  &sk RCTRL    &sk LEFT_SHIFT  &kp LC(O)     &kp LEFT       &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp LC(I)
&trans        &trans        &trans       &trans          &trans        &kp PAGE_DOWN  &kp LC(C)       &kp LC(V)     &kp LC(A)        &kp DELETE
                                         &trans          &trans        &trans         &to 3
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans    &trans     &trans     &trans    &kp F12  &kp F7  &kp F8  &kp F9  &trans
&trans  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp F11  &kp F4  &kp F5  &kp F6  &trans
&trans  &trans    &trans     &trans     &trans    &kp F10  &kp F1  &kp F2  &kp F3  &trans
                             &to 0      &trans    &trans   &trans
            >;
        };
    };
};
